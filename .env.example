APP_NAME="EVE - Gewiss Gatepass Interface"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=change-this-to-a-long-random-string-at-least-32-characters
APP_TIMEZONE=Europe/Budapest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eve_gatepass_interface
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=php_mvc_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax

JWT_SECRET=change-this-to-a-separate-long-random-secret
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost:8000
JWT_TTL=3600

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="EVE - Gewiss Gatepass Interface"

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
PASSWORD_RESET_TTL=86400
