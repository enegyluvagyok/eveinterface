{
  "name": "starter/php-mvc-starter",
  "description": "Secure frameworkless PHP MVC starter pack",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "firebase/php-jwt": "^7.0",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Core/helpers.php"
    ]
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "migrate": "php database/migrate.php",
    "seed:admin": "php database/seed_admin.php",
    "seed:demo": "php database/seed_demo.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
